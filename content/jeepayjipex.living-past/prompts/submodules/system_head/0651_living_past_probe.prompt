{# Direct dialogue history for the selected actor. #}
{% if render_mode == "full" and default(task_at_end, false) and not exists("stealthHiddenPlayer") %}
{% if exists("npc") and existsIn(npc, "UUID") and exists("responseTarget") and responseTarget and responseTarget.UUID != 0 %}
{% if npc.UUID != 0 and is_player(responseTarget.UUID) %}
{% set revision = papyrus_util("GetIntValue", npc.UUID, "LivingPast.Chronicle.Revision", 0) %}
{% if revision == 0 %}
{% set playerRevision = papyrus_util("GetIntValue", responseTarget.UUID, "LivingPast.NativeProbe.Revision", 0) %}
{% if playerRevision > 0 %}
{% set match = living_past_base_probe(npc.UUID) %}
{% if existsIn(match, "revision") and match.revision == playerRevision %}
{% set probeKey = "LivingPast.NativeProbe.History2" %}
{% if odd(playerRevision) %}{% set probeKey = "LivingPast.NativeProbe.History1" %}{% endif %}
{% set probeHistory = papyrus_util("GetStringValue", responseTarget.UUID, probeKey, "") %}
{% if length(probeHistory) > 0 and playerRevision == papyrus_util("GetIntValue", responseTarget.UUID, "LivingPast.NativeProbe.Revision", 0) %}
{% set probeHistory = replace(replace(replace(replace(replace(probeHistory, "%20", " "), "%09", "\t"), "%0A", "\n"), "%0D", "\r"), "%25", "%") %}
## Your prior history with the player
{{ replace(replace(probeHistory, "[", "("), "]", ")") }}
Let this history inform your tone and relevant memories naturally. Do not recite it unless it fits the conversation.
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% set slot = 0 %}
{% if revision > 0 %}
{% if odd(revision) %}{% set slot = 1 %}{% else %}{% set slot = 2 %}{% endif %}
{% endif %}
{% set history = "" %}
{% set encodedKey = "" %}
{% set legacyKey = "" %}
{% if slot == 1 %}
{% set encodedKey = "LivingPast.Chronicle.History1" %}
{% set legacyKey = "LivingPast.Chronicle.History1" %}
{% else if slot == 2 %}
{% set encodedKey = "LivingPast.Chronicle.History2" %}
{% set legacyKey = "LivingPast.Chronicle.History2" %}
{% endif %}
{% if length(encodedKey) > 0 %}
{% if papyrus_util("HasStringValue", npc.UUID, encodedKey) %}
{% set encoded = papyrus_util("GetStringValue", npc.UUID, encodedKey, "") %}
{% set history = replace(encoded, "%20", " ") %}
{% set history = replace(history, "%09", "\t") %}
{% set history = replace(history, "%0A", "\n") %}
{% set history = replace(history, "%0D", "\r") %}
{% set history = replace(history, "%25", "%") %}
{% else %}
{% set history = papyrus_util("GetStringValue", npc.UUID, legacyKey, "") %}
{% endif %}
{% endif %}
{% if length(history) > 0 %}
{% set label = papyrus_util("GetStringValue", npc.UUID, replace(encodedKey, "History", "Label"), "") %}
{% set label = replace(replace(replace(replace(replace(label, "%20", " "), "%09", "\t"), "%0A", "\n"), "%0D", "\r"), "%25", "%") %}
{% if length(label) > 0 and revision == papyrus_util("GetIntValue", npc.UUID, "LivingPast.Chronicle.Revision", 0) %}
## Your prior history with the player
Your prior relationship: {{ replace(replace(label, "[", "("), "]", ")") }}
{{ replace(replace(history, "[", "("), "]", ")") }}
Let this history inform your tone and relevant memories naturally. Do not recite it unless it fits the conversation.
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
