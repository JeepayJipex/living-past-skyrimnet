{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-past.invalid/catalog/v1",
  "title": "Living Past NPC catalog version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "actors",
    "exclusions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "exclusions": {
      "type": "object",
      "required": [
        "deleted",
        "initiallyDisabled",
        "nonPersistent",
        "invalidBase",
        "unnamed",
        "nonUnique",
        "conditional",
        "ambiguous"
      ],
      "additionalProperties": false,
      "properties": {
        "deleted": {
          "$ref": "#/$defs/count"
        },
        "initiallyDisabled": {
          "$ref": "#/$defs/count"
        },
        "nonPersistent": {
          "$ref": "#/$defs/count"
        },
        "invalidBase": {
          "$ref": "#/$defs/count"
        },
        "unnamed": {
          "$ref": "#/$defs/count"
        },
        "nonUnique": {
          "$ref": "#/$defs/count"
        },
        "conditional": {
          "$ref": "#/$defs/count"
        },
        "ambiguous": {
          "$ref": "#/$defs/count"
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identity": {
      "type": "object",
      "required": [
        "plugin",
        "localId"
      ],
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string",
          "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f]+\\.[Ee][Ss][MmPpLl]$"
        },
        "localId": {
          "type": "string",
          "pattern": "^(?!000000)[0-9A-F]{6}$"
        }
      }
    },
    "actor": {
      "type": "object",
      "required": [
        "reference",
        "base",
        "name",
        "editorId",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/identity"
        },
        "base": {
          "$ref": "#/$defs/identity"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "editorId": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    }
  }
}
